{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cotizador de Trailers",
  "version": "0.2.2",
  "identifier": "com.binamaquinarias.cotizadortrailers",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cotizador de Trailers",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "target/release/WebView2Loader.dll": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMkY3NjFDMjgyMDJBRTgKUldUb0tpQW9ISFl2THRXR1hTRTNXbm1URE5tZGc3UDd3VkRHM0RUeVFaYU1RV1lDSDhlVmx6WU0K",
      "endpoints": [
        "https://github.com/MartinBinaghi/Cotizador-de-trailers/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
